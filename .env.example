# Required — get one (free, instant) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — only needed if you want cloud sync for the Tracker.
# Get these from your Supabase project: Settings → API.
# Both are PUBLIC by design (bundled into client JS); security comes from
# Row Level Security policies on the database, not from key secrecy.
# Leave blank to run in local-first / no-account mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
